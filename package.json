{
  "name": "dashstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"npm run api\"",
    "dev:web": "vite",
    "api": "json-server --watch db.json --host 127.0.0.1 --port 3001",
    "start:api": "json-server db.json --host 0.0.0.0 --port ${PORT:-3001}",
    "seed": "node scripts/generate-db.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "concurrently": "^8.2.2",
    "json-server": "0.17.4"
  }
}
